{
  "name": "caregiver-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:local": "expo start --localhost",
    "start:web": "expo start --web --localhost",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "voice-server": "cd voice-backend && npm start",
    "build:android": "eas build --platform android",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:dev": "eas build --platform android --profile development",
    "build:web": "expo export --platform web",
    "build:all": "eas build --platform all"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/stack": "^7.0.28",
    "expo": "~54.0.0",
    "expo-av": "^16.0.8",
    "expo-camera": "~17.0.10",
    "expo-document-picker": "~55.0.8",
    "expo-file-system": "~19.0.21",
    "expo-image-picker": "~17.0.10",
    "expo-notifications": "~0.32.16",
    "expo-status-bar": "~3.0.9",
    "firebase": "^11.0.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-paper": "^5.15.0",
    "react-native-safe-area-context": "~5.6.0",
